<Project Sdk="Microsoft.NET.Sdk">
  <!-- The website API's key, kept out of the repository: copy windows/Local.example.props to windows/Local.props. -->
  <Import Project="..\..\Local.props" Condition="Exists('..\..\Local.props')" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Nama.App</RootNamespace>
    <AssemblyName>Win - 30nama</AssemblyName>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- An ordinary program with an installer of its own, not a Store package. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\30nama.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <!-- Program.cs has the entry point: it keeps the app to one copy. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nama.Core\Nama.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Mac app's typeface and logo, read from where they already are in the repository. -->
    <Content Include="..\..\..\30nama\Shared\Fonts\Vazirmatn-*.ttf" Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\30nama\Mac\Assets.xcassets\Logo.imageset\logo@2x.png" Link="Assets\Logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\30nama.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\30nama-256.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fetched by windows/tools/fetch-libmpv.ps1. -->
    <None Include="..\..\libmpv\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\libmpv\libmpv-2.dll')" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="NamaSiteKey" Value="$(NamaSiteKey)" />
  </ItemGroup>
  <Target Name="NeedsLibmpv" BeforeTargets="Build" Condition="!Exists('..\..\libmpv\libmpv-2.dll')">
    <Error Text="libmpv-2.dll is missing. Run: pwsh windows/tools/fetch-libmpv.ps1" />
  </Target>
</Project>
