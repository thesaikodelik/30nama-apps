<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Nama.App</RootNamespace>
    <!-- An identifier cannot start with a digit, so the program is Nama.exe; people see the name 30nama. -->
    <AssemblyName>Nama</AssemblyName>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- An ordinary program with an installer of its own, not a Store package. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nama.Core\Nama.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fetched by windows/tools/fetch-libmpv.ps1. -->
    <None Include="..\..\libmpv\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\libmpv\libmpv-2.dll')" />
  </ItemGroup>
  <Target Name="NeedsLibmpv" BeforeTargets="Build" Condition="!Exists('..\..\libmpv\libmpv-2.dll')">
    <Error Text="libmpv-2.dll is missing. Run: pwsh windows/tools/fetch-libmpv.ps1" />
  </Target>
</Project>
