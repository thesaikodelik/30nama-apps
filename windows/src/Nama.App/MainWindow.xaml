<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Nama.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:player="using:Nama.App.Player"
    Title="30nama">
    <Grid Background="Black">
        <player:VideoSurface x:Name="Surface" />
        <Border VerticalAlignment="Bottom" Margin="24" Padding="16,10" CornerRadius="14"
                Background="#99202020" BorderBrush="#33FFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Button x:Name="PlayButton" Click="OnPlayPause" Content="Pause" />
                <TextBlock x:Name="Clock" VerticalAlignment="Center" Foreground="White" Text="0:00 / 0:00" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
